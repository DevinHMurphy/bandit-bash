; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bandit Bash"
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

NetLog="*res://scripts/autoload/net_log.gd"
SteamManager="*res://scripts/autoload/steam_manager.gd"
SteamNetwork="*res://scripts/autoload/steam_network.gd"
SaveService="*res://scripts/autoload/save_service.gd"
CampaignService="*res://scripts/autoload/campaign_service.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[logging]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
