[gd_resource type="Resource" script_class="EnemyClassDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="2_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/gain_resource.gd" id="3_gain"]
[ext_resource type="Script" path="res://scripts/effects/blocks/selectors/area.gd" id="4_area"]
[ext_resource type="Script" path="res://scripts/effects/blocks/values/constant.gd" id="5_con"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/effect_condition.gd" id="6_cond"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/counter_condition.gd" id="7_count"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/add_timed_modifier.gd" id="8_timed"]
[ext_resource type="Script" path="res://scripts/content/enemy_class_definition.gd" id="9_def"]
[ext_resource type="Resource" path="res://data/shapes/adjacent.tres" id="10_shape"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/modify_value.gd" id="11_mod"]
[ext_resource type="Script" path="res://scripts/effects/blocks/values/resource_of.gd" id="12_res"]

[sub_resource type="Resource" id="Resource_adjacent"]
script = ExtResource("4_area")
shape = ExtResource("10_shape")
side = 2

[sub_resource type="Resource" id="Resource_stance"]
script = ExtResource("12_res")
pool = 2

[sub_resource type="Resource" id="Resource_def"]
script = ExtResource("11_mod")
key = 19
value = 2.0
per = SubResource("Resource_stance")

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("11_mod")
key = 1000
value = 1.0
per = SubResource("Resource_stance")

[sub_resource type="Resource" id="Resource_braced"]
script = ExtResource("1_eff")
id = "braced"
operations = Array[ExtResource("2_ops")]([SubResource("Resource_def"), SubResource("Resource_damage")])

[sub_resource type="Resource" id="Resource_every_2nd"]
script = ExtResource("7_count")
mode = 0
count = 2
lane = 0

[sub_resource type="Resource" id="Resource_fortify_amount"]
script = ExtResource("5_con")
value = 4.0

[sub_resource type="Resource" id="Resource_fortify_block"]
script = ExtResource("3_gain")
target = SubResource("Resource_adjacent")
amount = SubResource("Resource_fortify_amount")

[sub_resource type="Resource" id="Resource_fortify_parry"]
script = ExtResource("8_timed")
target = SubResource("Resource_adjacent")
key = 3
value = 1.0
end = 2

[sub_resource type="Resource" id="Resource_fortify"]
script = ExtResource("1_eff")
id = "fortify"
trigger = 1
conditions = Array[ExtResource("6_cond")]([SubResource("Resource_every_2nd")])
operations = Array[ExtResource("2_ops")]([SubResource("Resource_fortify_block"), SubResource("Resource_fortify_parry")])

[resource]
script = ExtResource("9_def")
behavior = 1
target_rule_id = "back_line_ally"
target_rule_text = "Stays next to its pack's back-line ally"
signature_move = SubResource("Resource_fortify")
signature_name = "Fortify"
base_class_id = "stonelet"
trait_name = "Braced"
weapon_types = PackedStringArray("monster")
movement_type = 1
tags = PackedStringArray("armored")
stance = 3
starting_weapon_id = "stone_fists"
innate_effects = Array[ExtResource("1_eff")]([])
base_stats = Dictionary[int, int]({0: 25, 1: 5, 2: 2, 3: 3, 4: 1, 5: 14, 6: 4})
growths = Dictionary[int, int]({0: 70, 1: 25, 2: 28, 3: 45, 4: 10})
upgraded_effects = Array[ExtResource("1_eff")]([])
upgrade_stat_gains = Dictionary[int, int]({})
upgrade_weapon_types = PackedStringArray()
upgrade_tags = PackedStringArray()
is_commander = false
id = "stone_golem"
display_name = "Stone Golem"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_braced"), SubResource("Resource_fortify")])
