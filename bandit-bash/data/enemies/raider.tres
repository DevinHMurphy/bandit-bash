[sub_resource type="Resource" id="Resource_amount"]
script = ExtResource("7_con")
value = 3.0

[sub_resource type="Resource" id="Resource_splash"]
script = ExtResource("5_splash")
target = SubResource("Resource_around_target")
amount = SubResource("Resource_amount")

[sub_resource type="Resource" id="Resource_trample"]
script = ExtResource("1_eff")
id = "trample"
trigger = 8
conditions = Array[ExtResource("2_cond")]([SubResource("Resource_charged")])
operations = Array[ExtResource("3_ops")]([SubResource("Resource_splash")])

[resource]
script = ExtResource("9_def")
behavior = 4
target_rule_id = "back_line_foes"
target_rule_text = "Any foe it can defeat this turn, splash included"
trait_name = "Trample"
