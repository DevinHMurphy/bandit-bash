tags = PackedStringArray("mounted")
stance = 2
starting_weapon_id = "javelin"
innate_effects = Array[ExtResource("1_eff")]([])
base_stats = Dictionary[int, int]({0: 21, 1: 6, 2: 4, 3: 5, 4: 1, 5: 12, 6: 7})
growths = Dictionary[int, int]({0: 85, 1: 40, 2: 27, 3: 25, 4: 10})
upgraded_effects = Array[ExtResource("1_eff")]([])
upgrade_stat_gains = Dictionary[int, int]({})
upgrade_weapon_types = PackedStringArray()
upgrade_tags = PackedStringArray()
is_commander = false
id = "raider"
