[gd_resource type="Resource" script_class="EnemyClassDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="2_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/gain_resource.gd" id="3_gain"]
[ext_resource type="Script" path="res://scripts/effects/blocks/selectors/area.gd" id="4_area"]
[ext_resource type="Script" path="res://scripts/effects/blocks/values/constant.gd" id="5_con"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/effect_condition.gd" id="6_cond"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/counter_condition.gd" id="7_count"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/while_state_condition.gd" id="8_state"]
[ext_resource type="Script" path="res://scripts/content/enemy_class_definition.gd" id="9_def"]
[ext_resource type="Resource" path="res://data/shapes/adjacent_with_center.tres" id="10_shape"]
[ext_resource type="Resource" path="res://data/shapes/within_2_with_center.tres" id="11_storm_shape"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/add_timed_modifier.gd" id="12_timed"]

[sub_resource type="Resource" id="Resource_around_target"]
script = ExtResource("4_area")
center = 2
shape = ExtResource("10_shape")
side = 2
is_owner_excluded = true

[sub_resource type="Resource" id="Resource_amount"]
script = ExtResource("5_con")
value = -1.0

[sub_resource type="Resource" id="Resource_stance"]
script = ExtResource("3_gain")
pool = 2
target = SubResource("Resource_around_target")
amount = SubResource("Resource_amount")

[sub_resource type="Resource" id="Resource_no_storm"]
script = ExtResource("8_state")
state = 5
permission = 3008

[sub_resource type="Resource" id="Resource_curse"]
script = ExtResource("1_eff")
id = "curse"
trigger = 8
conditions = Array[ExtResource("6_cond")]([SubResource("Resource_no_storm")])
operations = Array[ExtResource("2_ops")]([SubResource("Resource_stance")])

[sub_resource type="Resource" id="Resource_within_2_of_target"]
script = ExtResource("4_area")
center = 2
shape = ExtResource("11_storm_shape")
side = 2
is_owner_excluded = true

[sub_resource type="Resource" id="Resource_storm_stance"]
script = ExtResource("3_gain")
pool = 2
target = SubResource("Resource_within_2_of_target")
amount = SubResource("Resource_amount")

[sub_resource type="Resource" id="Resource_storm"]
script = ExtResource("8_state")
state = 4
permission = 3008

[sub_resource type="Resource" id="Resource_storm_curse"]
script = ExtResource("1_eff")
id = "hex_storm_curse"
trigger = 8
conditions = Array[ExtResource("6_cond")]([SubResource("Resource_storm")])
operations = Array[ExtResource("2_ops")]([SubResource("Resource_storm_stance")])

[sub_resource type="Resource" id="Resource_every_3rd"]
script = ExtResource("7_count")
mode = 0
count = 3
lane = 0

[sub_resource type="Resource" id="Resource_grant_storm"]
script = ExtResource("12_timed")
key = 3008
mode = 6
end = 1
uses = 1

[sub_resource type="Resource" id="Resource_hex_storm"]
script = ExtResource("1_eff")
id = "hex_storm"
trigger = 1
conditions = Array[ExtResource("6_cond")]([SubResource("Resource_every_3rd")])
operations = Array[ExtResource("2_ops")]([SubResource("Resource_grant_storm")])

[resource]
script = ExtResource("9_def")
behavior = 4
target_rule_id = "most_cursed"
target_rule_text = "The foe whose curse catches the most player units"
signature_move = SubResource("Resource_hex_storm")
signature_name = "Hex Storm"
base_class_id = "hexer"
trait_name = "Curse"
weapon_types = PackedStringArray("dark")
movement_type = 0
tags = PackedStringArray()
stance = 1
starting_weapon_id = "simple_dark"
innate_effects = Array[ExtResource("1_eff")]([])
base_stats = Dictionary[int, int]({0: 17, 1: 8, 2: 3, 3: 3, 4: 4, 5: 12, 6: 5})
growths = Dictionary[int, int]({0: 75, 1: 65, 2: 22, 3: 18, 4: 30})
upgraded_effects = Array[ExtResource("1_eff")]([])
upgrade_stat_gains = Dictionary[int, int]({})
upgrade_weapon_types = PackedStringArray()
upgrade_tags = PackedStringArray()
is_commander = false
id = "hex_matron"
display_name = "Hex Matron"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_curse"), SubResource("Resource_hex_storm"), SubResource("Resource_storm_curse")])
