growths = Dictionary[int, int]({0: 115, 1: 60, 2: 35, 3: 20, 4: 15})
upgraded_effects = Array[ExtResource("1_eff")]([])
upgrade_stat_gains = Dictionary[int, int]({})
upgrade_weapon_types = PackedStringArray()
upgrade_tags = PackedStringArray()
is_commander = false
id = "brute"
