pool = 1
amount = SubResource("Resource_per_ally_plus")

[sub_resource type="Resource" id="Resource_phalanx_plus"]
script = ExtResource("1_eff")
id = "phalanx_plus"
trigger = 2
operations = Array[ExtResource("3_ops")]([SubResource("Resource_block_plus")])

[resource]
script = ExtResource("9_def")
