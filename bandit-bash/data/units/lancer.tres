[ext_resource type="Resource" path="res://data/shapes/adjacent.tres" id="7_adj"]
[ext_resource type="Script" path="res://scripts/content/unit_type_definition.gd" id="9_def"]

[sub_resource type="Resource" id="Resource_adjacent_allies"]
script = ExtResource("6_area")
center = 0
