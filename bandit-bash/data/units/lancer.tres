[sub_resource type="Resource" id="Resource_block"]
script = ExtResource("4_gain")
pool = 1
amount = SubResource("Resource_per_ally")

[sub_resource type="Resource" id="Resource_phalanx"]
script = ExtResource("1_eff")
id = "phalanx"
trigger = 2
operations = Array[ExtResource("3_ops")]([SubResource("Resource_block")])

[sub_resource type="Resource" id="Resource_per_ally_plus"]
