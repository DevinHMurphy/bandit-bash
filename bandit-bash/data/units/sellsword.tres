[sub_resource type="Resource" id="Resource_block"]
script = ExtResource("5_gain")
pool = 1
amount = SubResource("Resource_amount")

[sub_resource type="Resource" id="Resource_professional"]
script = ExtResource("1_eff")
id = "professional"
trigger = 3
conditions = Array[ExtResource("2_cond")]([SubResource("Resource_advantage")])
operations = Array[ExtResource("3_ops")]([SubResource("Resource_block")])

[sub_resource type="Resource" id="Resource_amount_plus"]
