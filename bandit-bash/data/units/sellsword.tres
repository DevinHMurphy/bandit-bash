pool = 1
amount = SubResource("Resource_amount_plus")

[sub_resource type="Resource" id="Resource_professional_plus"]
script = ExtResource("1_eff")
id = "professional_plus"
trigger = 3
conditions = Array[ExtResource("2_cond")]([SubResource("Resource_advantage")])
operations = Array[ExtResource("3_ops")]([SubResource("Resource_block_plus")])

