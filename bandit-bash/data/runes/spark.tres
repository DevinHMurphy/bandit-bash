[gd_resource type="Resource" script_class="RuneDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="2_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/custom_operation.gd" id="3_custom"]
[ext_resource type="Script" path="res://scripts/content/rune_definition.gd" id="9_def"]

[sub_resource type="Resource" id="Resource_wording"]
script = ExtResource("3_custom")
text = "a powder keg anywhere on the map explodes"

[sub_resource type="Resource" id="Resource_cast"]
script = ExtResource("1_eff")
id = "explode_keg"
operations = Array[ExtResource("2_ops")]([SubResource("Resource_wording")])

[resource]
script = ExtResource("9_def")
target_kind = "object"
id = "spark"
display_name = "Spark"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_cast")])
