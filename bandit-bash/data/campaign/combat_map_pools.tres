[gd_resource type="Resource" script_class="CombatMapPools" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/campaign/combat_map_pools.gd" id="1_pools"]
[ext_resource type="Script" path="res://scripts/campaign/combat_map_pool.gd" id="2_pool"]
[ext_resource type="Script" path="res://scripts/map/combat_map_definition.gd" id="3_map"]
[ext_resource type="Resource" path="res://maps/standard/m1_greybox.tres" id="4_m1"]
[ext_resource type="Resource" path="res://maps/standard/crossroads.tres" id="5_crossroads"]
[ext_resource type="Resource" path="res://maps/standard/river_ford.tres" id="6_river_ford"]
[ext_resource type="Resource" path="res://maps/standard/old_mill.tres" id="7_old_mill"]
[ext_resource type="Resource" path="res://maps/standard/ruined_chapel.tres" id="8_ruined_chapel"]

; The steps are game-vision.md's Run structure: floors 1-5, 6-11 and 12-17, the boss on 18. Key
; combats start on floor 6 (campaign map rules: no extra Key before floor 6). Every standard pool
; holds the same M2 maps: a map isn't drawn again until its pool is used up, counted across the
; whole run, so a run rarely repeats one. The Defeat the Leader maps (bandit_camp, watch_post)
; join them once P05 EN7 fills the leader slot. The key pools keep m1_greybox until the M2 key
; maps (P04 MP10b), and the boss pool until the Powder Baron's map (P05 EN11).
[sub_resource type="Resource" id="Resource_standard_1"]
script = ExtResource("2_pool")
node_type = 0
first_floor = 1
last_floor = 5
maps = Array[ExtResource("3_map")]([ExtResource("5_crossroads"), ExtResource("6_river_ford"), ExtResource("7_old_mill"), ExtResource("8_ruined_chapel")])

[sub_resource type="Resource" id="Resource_standard_2"]
