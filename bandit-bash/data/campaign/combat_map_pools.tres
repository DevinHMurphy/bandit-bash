[ext_resource type="Script" path="res://scripts/map/combat_map_definition.gd" id="3_map"]
[ext_resource type="Resource" path="res://maps/standard/m1_greybox.tres" id="4_m1"]

; Until RN11 builds the per-step pools, m1_greybox is every pool's only map. The steps are
; game-vision.md's Run structure: floors 1-5, 6-11 and 12-17, the boss on 18. Key combats start on
; floor 6 (campaign map rules: no extra Key before floor 6).
[sub_resource type="Resource" id="Resource_standard_1"]
script = ExtResource("2_pool")
node_type = 0
first_floor = 1
last_floor = 5
maps = Array[ExtResource("3_map")]([ExtResource("4_m1")])

