[gd_resource type="Resource" script_class="EventDefinition" format=3]

[ext_resource type="Script" path="res://scripts/events/event_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/events/event_option.gd" id="2_opt"]
[ext_resource type="Script" path="res://scripts/events/event_outcome.gd" id="3_out"]
[ext_resource type="Script" path="res://scripts/events/outcomes/stat_outcome.gd" id="4_stat"]
[ext_resource type="Script" path="res://scripts/events/outcomes/item_modification_outcome.gd" id="5_mod"]
[ext_resource type="Script" path="res://scripts/events/outcomes/item_grant_outcome.gd" id="6_grant"]
[ext_resource type="Texture2D" path="res://assets/sprites/events/cavern_of_echoing_steel_background.png" id="20_art"]

[sub_resource type="Resource" id="Resource_resonance"]
script = ExtResource("5_mod")
stat_deltas = Dictionary[int, float]({
1: 4.0,
2: 1.0
})

[sub_resource type="Resource" id="Resource_forge"]
script = ExtResource("2_opt")
title = "Forge Resonance"
text = "A chosen weapon gains +1 AtkX and +4 weight."
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_resonance")])

[sub_resource type="Resource" id="Resource_spd"]
script = ExtResource("4_stat")
stat = 2
amount = 2

[sub_resource type="Resource" id="Resource_listen"]
script = ExtResource("2_opt")
title = "Listen Carefully"
text = "A chosen unit gains +2 SPD."
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_spd")])

[sub_resource type="Resource" id="Resource_ore"]
script = ExtResource("6_grant")
item_id = "resonant_ore"

[sub_resource type="Resource" id="Resource_harvest"]
script = ExtResource("2_opt")
title = "Harvest Ore"
text = "Gain the Resonant Ore."
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_ore")])

[resource]
script = ExtResource("1_def")
id = "cavern_of_echoing_steel"
title = "Cavern of Echoing Steel"
text = "Walls shimmer with metallic resonance."
art = ExtResource("20_art")
options = Array[ExtResource("2_opt")]([SubResource("Resource_forge"), SubResource("Resource_listen"), SubResource("Resource_harvest")])
