[gd_resource type="Resource" script_class="EventDefinition" format=3]

[ext_resource type="Script" path="res://scripts/events/event_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/events/event_option.gd" id="2_opt"]
[ext_resource type="Script" path="res://scripts/events/event_outcome.gd" id="3_out"]
[ext_resource type="Script" path="res://scripts/events/event_requirements.gd" id="4_req"]
[ext_resource type="Script" path="res://scripts/events/outcomes/stat_outcome.gd" id="5_stat"]
[ext_resource type="Script" path="res://scripts/events/outcomes/item_modification_outcome.gd" id="6_mod"]
[ext_resource type="Script" path="res://scripts/events/outcomes/gold_outcome.gd" id="7_gold"]
[ext_resource type="Script" path="res://scripts/events/outcomes/upgrade_outcome.gd" id="8_upgrade"]
[ext_resource type="Texture2D" path="res://assets/sprites/events/clockwerk_hermit_background.png" id="20_art"]

; "+1 damage" adds to the Attack damage stage (1000), as a weapon prefix's damage does
; in Loadout; "+5 crit" is 5 points of Crit chance (6). Godot_FE's +5 durability is dropped.
[sub_resource type="Resource" id="Resource_gear"]
script = ExtResource("6_mod")
stat_deltas = Dictionary[int, float]({
1: 1.0,
6: 5.0,
1000: 1.0
})

[sub_resource type="Resource" id="Resource_upgrade_gear"]
script = ExtResource("2_opt")
title = "Upgrade Gear"
text = "A chosen weapon gains +1 damage, +5 crit and +1 weight."
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_gear")])

[sub_resource type="Resource" id="Resource_forty_gold"]
script = ExtResource("4_req")
gold = 40

[sub_resource type="Resource" id="Resource_pay"]
script = ExtResource("7_gold")
amount = -40

[sub_resource type="Resource" id="Resource_train"]
script = ExtResource("8_upgrade")

[sub_resource type="Resource" id="Resource_augment"]
script = ExtResource("2_opt")
title = "Augment Unit"
text = "Pay 40 gold: upgrade a chosen unit, as a Camp's Train."
requirements = SubResource("Resource_forty_gold")
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_pay"), SubResource("Resource_train")])

[sub_resource type="Resource" id="Resource_hit"]
script = ExtResource("5_stat")
stat = 100
amount = 10

[sub_resource type="Resource" id="Resource_analyze"]
script = ExtResource("2_opt")
title = "Analyze the Mechanisms"
text = "A chosen unit gains +10 Hit, permanently."
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_hit")])

; the scene text is Godot_FE's clockwork_hermit.tres description with its BBCode
; removed (the event screen shows plain text).
[resource]
script = ExtResource("1_def")
id = "clockwork_hermit"
title = "The Clockwork Hermit"
text = "Deep within a cluttered workshop, an eccentric hermit tinkers with gears that hum with unnatural precision. Mechanical creations clatter and whirl around him as he beckons you closer, eager for a willing subject to test his latest invention."
art = ExtResource("20_art")
options = Array[ExtResource("2_opt")]([SubResource("Resource_upgrade_gear"), SubResource("Resource_augment"), SubResource("Resource_analyze")])
