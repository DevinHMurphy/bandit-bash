[gd_resource type="Resource" script_class="EventDefinition" format=3]

[ext_resource type="Script" path="res://scripts/events/event_definition.gd" id="1_def"]
[ext_resource type="Script" path="res://scripts/events/event_option.gd" id="2_opt"]
[ext_resource type="Script" path="res://scripts/events/event_outcome.gd" id="3_out"]
[ext_resource type="Script" path="res://scripts/events/outcomes/stat_outcome.gd" id="4_stat"]
[ext_resource type="Script" path="res://scripts/events/outcomes/item_grant_outcome.gd" id="5_grant"]
[ext_resource type="Script" path="res://scripts/events/outcomes/hp_percent_outcome.gd" id="6_hp"]
[ext_resource type="Texture2D" path="res://assets/sprites/events/frozen_armory_background.png" id="20_art"]

[sub_resource type="Resource" id="Resource_weapon"]
script = ExtResource("5_grant")
random = 1

[sub_resource type="Resource" id="Resource_cold"]
script = ExtResource("6_hp")
percent = -20

[sub_resource type="Resource" id="Resource_break"]
script = ExtResource("2_opt")
title = "Break the Ice"
text = "Gain a random rare weapon. Every unit takes damage equal to 20% of its max HP from the cold."
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_weapon"), SubResource("Resource_cold")])

[sub_resource type="Resource" id="Resource_res"]
script = ExtResource("4_stat")
stat = 4
amount = 2

[sub_resource type="Resource" id="Resource_chill"]
script = ExtResource("2_opt")
title = "Channel the Chill"
text = "A chosen unit gains +2 RES."
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_res")])

[sub_resource type="Resource" id="Resource_heal"]
script = ExtResource("6_hp")
percent = 20

[sub_resource type="Resource" id="Resource_warm"]
script = ExtResource("2_opt")
title = "Stay Warm"
text = "Every unit heals 20% of its max HP."
outcomes = Array[ExtResource("3_out")]([SubResource("Resource_heal")])

; ASSUMPTION: the scene text is Godot_FE's frozen_armory.tres description with its BBCode removed
; (the event screen shows plain text).
[resource]
script = ExtResource("1_def")
id = "frozen_armory"
title = "Frozen Armory"
text = "Frost clings to every surface of an ancient vault. The air itself bites, each breath stirring only a faint swirl of glittering ice crystals across the frozen floor. Even the strongest steel here has grown fragile, its once-perfect edges now quivering beneath the weight of unrelenting winter."
art = ExtResource("20_art")
options = Array[ExtResource("2_opt")]([SubResource("Resource_break"), SubResource("Resource_chill"), SubResource("Resource_warm")])
