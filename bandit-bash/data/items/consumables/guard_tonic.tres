[gd_resource type="Resource" script_class="ConsumableDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="2_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/gain_resource.gd" id="3_gain"]
[ext_resource type="Script" path="res://scripts/effects/blocks/selectors/command_target.gd" id="4_target"]
[ext_resource type="Script" path="res://scripts/effects/blocks/values/constant.gd" id="5_con"]
[ext_resource type="Script" path="res://scripts/content/consumable_definition.gd" id="9_def"]

[sub_resource type="Resource" id="Resource_target"]
script = ExtResource("4_target")

[sub_resource type="Resource" id="Resource_amount"]
script = ExtResource("5_con")
value = 6.0

[sub_resource type="Resource" id="Resource_block"]
script = ExtResource("3_gain")
pool = 1
target = SubResource("Resource_target")
amount = SubResource("Resource_amount")

; ASSUMPTION: combat uses an item through its use effect (ItemUseResolver), whose charges are its
; uses; use_kind, amount, uses and uses_lane below mirror it. Fragile: an editor re-save drops it.
[sub_resource type="Resource" id="Resource_use"]
script = ExtResource("1_eff")
id = "block"
operations = Array[ExtResource("2_ops")]([SubResource("Resource_block")])
charges = 1
charge_lane = 0

[resource]
script = ExtResource("9_def")
use_kind = "block"
amount = 6
uses = 1
uses_lane = 0
rarity = 1
weight = 0
tags = PackedStringArray()
id = "guard_tonic"
display_name = "Guard Tonic"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_use")])
