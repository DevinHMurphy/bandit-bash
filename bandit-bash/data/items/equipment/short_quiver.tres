[gd_resource type="Resource" script_class="EquipmentDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/effect_condition.gd" id="2_cond"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/while_state_condition.gd" id="3_state"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="4_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/modify_value.gd" id="5_mod"]
[ext_resource type="Script" path="res://scripts/content/equipment_definition.gd" id="6_def"]
[ext_resource type="Texture2D" path="res://assets/sprites/items/equipment/equipment_icon.png" id="icon_1"]

[sub_resource type="Resource" id="Resource_holding_bow"]
script = ExtResource("3_state")
state = 3
weapon_type = "bow"

[sub_resource type="Resource" id="Resource_range_min"]
script = ExtResource("5_mod")
key = 10
mode = 0
value = 1.0

[sub_resource type="Resource" id="Resource_range_max"]
script = ExtResource("5_mod")
key = 11
mode = 0
value = 2.0

[sub_resource type="Resource" id="Resource_close_range"]
script = ExtResource("1_eff")
id = "close_range"
conditions = Array[ExtResource("2_cond")]([SubResource("Resource_holding_bow")])
operations = Array[ExtResource("4_ops")]([SubResource("Resource_range_min"), SubResource("Resource_range_max")])

[resource]
script = ExtResource("6_def")
icon = ExtResource("icon_1")
category = "quiver"
granted_tags = PackedStringArray()
rarity = 2
weight = 1
tags = PackedStringArray()
id = "short_quiver"
display_name = "Short Quiver"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_close_range")])
