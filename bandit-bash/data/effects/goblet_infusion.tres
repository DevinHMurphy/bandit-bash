[gd_resource type="Resource" script_class="EffectDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="2_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/gain_resource.gd" id="3_gain"]
[ext_resource type="Script" path="res://scripts/effects/blocks/values/constant.gd" id="4_const"]

[sub_resource type="Resource" id="Resource_two"]
script = ExtResource("4_const")
value = 2.0

[sub_resource type="Resource" id="Resource_heal"]
script = ExtResource("3_gain")
pool = 0
amount = SubResource("Resource_two")

; Dark Goblet's Infuse (events.md): "Hit dealt: heal 2" on the weapon's holder. item_points 1 is
; items.md's hand-set value for this effect (Modified items).
[resource]
script = ExtResource("1_eff")
id = "goblet_infusion"
trigger = 8
operations = Array[ExtResource("2_ops")]([SubResource("Resource_heal")])
item_points = 1.0
