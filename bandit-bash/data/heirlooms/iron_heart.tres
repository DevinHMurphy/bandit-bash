[gd_resource type="Resource" script_class="HeirloomDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/effect_condition.gd" id="2_cond"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="3_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/counter_condition.gd" id="4_count"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/modify_that.gd" id="5_that"]
[ext_resource type="Script" path="res://scripts/content/heirloom_definition.gd" id="9_def"]

[sub_resource type="Resource" id="Resource_every_7th"]
script = ExtResource("4_count")
mode = 0
count = 7
lane = 0

[sub_resource type="Resource" id="Resource_lifesteal"]
script = ExtResource("5_that")
what = 2
flag = 0

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("1_eff")
