[gd_resource type="Resource" script_class="HeirloomDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/effect_condition.gd" id="2_cond"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="3_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/while_state_condition.gd" id="4_state"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/modify_value.gd" id="5_value"]
[ext_resource type="Script" path="res://scripts/content/heirloom_definition.gd" id="9_def"]
[ext_resource type="Texture2D" path="res://assets/sprites/heirlooms/heirloom_profile.svg" id="20_icon"]

[sub_resource type="Resource" id="Resource_nimble"]
script = ExtResource("4_state")
state = 2
profile = 3

[sub_resource type="Resource" id="Resource_speed"]
script = ExtResource("5_value")
key = 0
value = 2.0

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("1_eff")
id = "nimble_speed"
scope = 1
conditions = Array[ExtResource("2_cond")]([SubResource("Resource_nimble")])
operations = Array[ExtResource("3_ops")]([SubResource("Resource_speed")])

[resource]
script = ExtResource("9_def")
tier = "common"
kind = "profile"
id = "dueling_manual"
display_name = "Dueling Manual"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_effect")])
icon = ExtResource("20_icon")
