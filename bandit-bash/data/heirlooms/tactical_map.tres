[gd_resource type="Resource" script_class="HeirloomDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/effect_condition.gd" id="2_cond"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="3_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/conditions/counter_condition.gd" id="4_count"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/add_timed_modifier.gd" id="5_timed"]
[ext_resource type="Script" path="res://scripts/effects/blocks/selectors/all_of_scope.gd" id="6_scope"]
[ext_resource type="Script" path="res://scripts/content/heirloom_definition.gd" id="9_def"]

[sub_resource type="Resource" id="Resource_first"]
script = ExtResource("4_count")
mode = 1
lane = 0

[sub_resource type="Resource" id="Resource_your_units"]
script = ExtResource("6_scope")
scope = 1

[sub_resource type="Resource" id="Resource_movement"]
script = ExtResource("5_timed")
target = SubResource("Resource_your_units")
key = 15
value = 1.0
end = 1
uses = 0

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("1_eff")
id = "opening_movement"
trigger = 1
scope = 1
conditions = Array[ExtResource("2_cond")]([SubResource("Resource_first")])
operations = Array[ExtResource("3_ops")]([SubResource("Resource_movement")])

[resource]
script = ExtResource("9_def")
tier = "uncommon"
kind = "behavior"
id = "tactical_map"
display_name = "Tactical Map"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_effect")])
