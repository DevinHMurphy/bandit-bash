[gd_resource type="Resource" script_class="StartingHeirloomDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="3_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/modify_value.gd" id="4_value"]
[ext_resource type="Script" path="res://scripts/effects/blocks/values/triangle_change.gd" id="5_tri"]
[ext_resource type="Script" path="res://scripts/content/starting_heirloom_definition.gd" id="9_def"]
[ext_resource type="Texture2D" path="res://assets/sprites/heirlooms/heirloom_profile.svg" id="20_icon"]

[sub_resource type="Resource" id="Resource_damage_change"]
script = ExtResource("5_tri")

[sub_resource type="Resource" id="Resource_hit_change"]
