[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("1_eff")
id = "doubled_triangle"
scope = 1
operations = Array[ExtResource("3_ops")]([SubResource("Resource_damage"), SubResource("Resource_hit")])

[resource]
script = ExtResource("9_def")
tier = "starting"
id = "tacticians_manual"
