[gd_scene format=3]

[ext_resource type="Script" path="res://ui/common/text/keyword_tooltip.gd" id="1_tip"]

[node name="KeywordTooltip" type="PanelContainer"]
mouse_filter = 2
theme_type_variation = &"TooltipPanel"
script = ExtResource("1_tip")

[node name="Lines" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2

[node name="KeywordName" type="RichTextLabel" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"KeywordTooltipName"
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 0

[node name="Explanation" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TooltipLabel"
autowrap_mode = 3
