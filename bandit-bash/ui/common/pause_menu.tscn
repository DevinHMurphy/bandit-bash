[node name="SaveQuitConfirm" parent="Root/Panel" instance=ExtResource("3_confirm")]
unique_name_in_owner = true
visible = false
layout_mode = 2
question_text = "Save and end the match for everyone? Every player goes back to the main menu, and the run resumes from this save in the lobby."
confirm_text = "Save & Quit"

[node name="ForfeitConfirm" parent="Root/Panel" instance=ExtResource("3_confirm")]
unique_name_in_owner = true
visible = false
layout_mode = 2
question_text = "Forfeit the run? You leave it for good and your units leave with you; the others play on. The run is archived as forfeited."
confirm_text = "Forfeit"

[node name="InviteDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Invite"
dialog_text = "A friend invited you. Save & Quit this run and join them?"
ok_button_text = "Save & Join"
cancel_button_text = "Stay"
