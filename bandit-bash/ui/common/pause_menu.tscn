[gd_scene format=3]

[ext_resource type="Script" path="res://ui/common/pause_menu.gd" id="1_pause"]
[ext_resource type="PackedScene" path="res://ui/screens/options_panel.tscn" id="2_options"]
[ext_resource type="PackedScene" path="res://ui/common/menu_confirm.tscn" id="3_confirm"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
