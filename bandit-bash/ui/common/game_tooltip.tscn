[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/common/game_tooltip.gd" id="1_tooltip"]
[ext_resource type="PackedScene" path="res://ui/common/text/effect_text.tscn" id="2_text"]

[node name="GameTooltip" type="PanelContainer"]
mouse_filter = 2
theme_type_variation = &"TooltipPanel"
script = ExtResource("1_tooltip")

[node name="Lines" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2

[node name="TooltipName" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TooltipName"
autowrap_mode = 3

[node name="TooltipBody" parent="Lines" instance=ExtResource("2_text")]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2

[node name="TooltipFooter" type="Label" parent="Lines"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TooltipFooter"
autowrap_mode = 3
