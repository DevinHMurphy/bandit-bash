[gd_scene format=3]

[ext_resource type="Script" path="res://ui/campaign/victory/victory_rewards_stage.gd" id="1_stage"]

[node name="VictoryRewardsStage" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/separation = 16
alignment = 1
script = ExtResource("1_stage")

[node name="Heading" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Choose your rewards"

[node name="Rows" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2

[node name="Empty" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Nothing left to take."
horizontal_alignment = 1
