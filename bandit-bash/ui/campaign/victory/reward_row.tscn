[gd_scene format=3]

[ext_resource type="Script" path="res://ui/campaign/victory/reward_row.gd" id="1_row"]
[ext_resource type="PackedScene" path="res://ui/campaign/victory/reward_icon.tscn" id="2_icon"]

[node name="RewardRow" type="Button"]
custom_minimum_size = Vector2(0, 48)
size_flags_horizontal = 3
script = ExtResource("1_row")

[node name="Content" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="Line" type="HBoxContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Icon" parent="Content/Line" instance=ExtResource("2_icon")]
unique_name_in_owner = true
layout_mode = 2

[node name="Text" type="VBoxContainer" parent="Content/Line"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Title" type="Label" parent="Content/Line/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Reward"

[node name="Detail" type="Label" parent="Content/Line/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BodyLabel"
text = "What it offers"

[node name="Hint" type="Label" parent="Content/Line"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"MutedLabel"
text = "Choose"
