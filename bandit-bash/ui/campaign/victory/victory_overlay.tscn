[node name="VictoryOverlay" type="CanvasLayer"]
layer = 5
script = ExtResource("1_overlay")

[node name="Root" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Backdrop" type="ColorRect" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
