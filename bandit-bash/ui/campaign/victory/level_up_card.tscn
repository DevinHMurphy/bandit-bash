[gd_scene format=3]

[ext_resource type="Script" path="res://ui/campaign/victory/level_up_card.gd" id="1_card"]

[node name="LevelUpCard" type="PanelContainer"]
custom_minimum_size = Vector2(360, 0)
mouse_filter = 2
theme_type_variation = &"FloatingPanel"
script = ExtResource("1_card")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Ribbon" type="PanelContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"RibbonPanel"

[node name="RibbonText" type="Label" parent="Margin/Column/Ribbon"]
layout_mode = 2
theme_type_variation = &"RibbonLabel"
text = "Level up"
horizontal_alignment = 1

[node name="Name" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Unit"
horizontal_alignment = 1

[node name="Level" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BigNumberLabel"
text = "Level 2"
horizontal_alignment = 1

[node name="Gains" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BodyLabel"
text = "HP +1"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Count" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Level-up 1 of 1"
horizontal_alignment = 1
