[gd_scene format=3]

[ext_resource type="Script" path="res://ui/campaign/victory/grade_row.gd" id="1_row"]

[node name="GradeRow" type="PanelContainer"]
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"RowPanel"
script = ExtResource("1_row")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="Line" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Label" type="Label" parent="Margin/Line"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"BodyLabel"
text = "Grade"

[node name="Value" type="Label" parent="Margin/Line"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BodyLabel"
text = "+0 gold"
horizontal_alignment = 2
