[gd_scene format=3]

[ext_resource type="Script" path="res://ui/campaign/victory/victory_grade_stage.gd" id="1_stage"]

[node name="VictoryGradeStage" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
