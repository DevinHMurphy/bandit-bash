[node name="Row" type="HBoxContainer" parent="Center/Box"]
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Cards" type="HBoxContainer" parent="Center/Box/Row"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="BackButton" type="Button" parent="Center/Box/Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(120, 48)
layout_mode = 2
size_flags_vertical = 4
text = "Back"

[node name="SkipButton" type="Button" parent="Center/Box/Row"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(120, 48)
layout_mode = 2
size_flags_vertical = 4
text = "Skip"

[node name="UnitChoicePanel" parent="Center/Box" instance=ExtResource("2_units")]
