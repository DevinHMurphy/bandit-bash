[gd_scene format=3]

[ext_resource type="Script" path="res://ui/campaign/starting_offer_view.gd" id="1_view"]
[ext_resource type="PackedScene" path="res://ui/campaign/unit_choice_panel.tscn" id="2_units"]
[ext_resource type="PackedScene" path="res://ui/campaign/placement_panel.tscn" id="3_placement"]

[node name="StartingOfferView" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_view")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Choose a starting heirloom"
horizontal_alignment = 1

[node name="Question" type="Label" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Pick 1 of 3."
