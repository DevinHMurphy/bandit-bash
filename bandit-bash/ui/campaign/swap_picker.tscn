[gd_scene format=3]

[ext_resource type="Script" path="res://ui/campaign/swap_picker.gd" id="1_picker"]

[node name="SwapPicker" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1_picker")

[node name="Prompt" type="Label" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(640, 0)
layout_mode = 2
theme_type_variation = &"BodyLabel"
text = "Choose your unit to send to Player 2's map."
autowrap_mode = 3

[node name="UnitScroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
horizontal_scroll_mode = 0
follow_focus = true

[node name="Units" type="VBoxContainer" parent="UnitScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="BackButton" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 36)
layout_mode = 2
size_flags_horizontal = 0
text = "Back"
