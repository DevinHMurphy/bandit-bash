custom_minimum_size = Vector2(440, 0)
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Pick units, then one map to send them to."
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Column/PickPage"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SendButton" type="Button" parent="Column/PickPage/Buttons"]
