[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/battle/coop/send_panel.gd" id="1_panel"]
[ext_resource type="Theme" path="res://ui/theme/battle_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://ui/battle/coop/frozen_banner.tscn" id="3_rule"]

[node name="SendPanel" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -60.0
offset_right = 240.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
theme_type_variation = &"FloatingPanel"
script = ExtResource("1_panel")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_type_variation = &"HudHeading"
text = "Send units"

[node name="Rule" parent="Column" instance=ExtResource("3_rule")]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="PickPage" type="VBoxContainer" parent="Column"]
