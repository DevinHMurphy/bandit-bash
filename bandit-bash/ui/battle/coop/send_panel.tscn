layout_mode = 2
theme_override_constants/separation = 6

[node name="UnitsLabel" type="Label" parent="Column/PickPage"]
layout_mode = 2
theme_type_variation = &"HudText"
text = "Units"

[node name="UnitScroll" type="ScrollContainer" parent="Column/PickPage"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
follow_focus = true
horizontal_scroll_mode = 0

[node name="UnitRows" type="VBoxContainer" parent="Column/PickPage/UnitScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
