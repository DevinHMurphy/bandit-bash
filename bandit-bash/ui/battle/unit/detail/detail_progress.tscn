[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/battle/unit/detail/detail_progress.gd" id="1_progress"]
[ext_resource type="Theme" path="res://ui/theme/battle_theme.tres" id="2_theme"]

[node name="DetailProgress" type="HBoxContainer"]
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_progress")

[node name="Level" type="Label" parent="."]
