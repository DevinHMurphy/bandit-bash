text = "Lv 1"

[node name="XpBar" type="ProgressBar" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 8)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
step = 1.0
show_percentage = false

[node name="Xp" type="Label" parent="."]
