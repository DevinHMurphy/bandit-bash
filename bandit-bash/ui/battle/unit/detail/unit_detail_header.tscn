[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/battle/unit/detail/unit_detail_header.gd" id="1_header"]
[ext_resource type="Theme" path="res://ui/theme/battle_theme.tres" id="2_theme"]
[ext_resource type="Resource" path="res://assets/sprites/units/unit_sprites.tres" id="3_sprites"]
[ext_resource type="PackedScene" path="res://ui/battle/unit/detail/detail_progress.tscn" id="4_progress"]

[node name="UnitDetailHeader" type="VBoxContainer"]
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_header")
sprites = ExtResource("3_sprites")

[node name="Top" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Sprite" type="TextureRect" parent="Top"]
unique_name_in_owner = true
texture_filter = 1
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_vertical = 0
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Identity" type="VBoxContainer" parent="Top"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="UnitName" type="Label" parent="Top/Identity"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudHeading"
text = "Unit"

[node name="Summary" type="Label" parent="Top/Identity"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudNote"
autowrap_mode = 3

[node name="Vitals" type="Label" parent="Top/Identity"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudText"

[node name="HpBar" type="ProgressBar" parent="Top/Identity"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 8)
layout_mode = 2
size_flags_horizontal = 0
mouse_filter = 2
step = 1.0
show_percentage = false

[node name="Progress" parent="Top/Identity" instance=ExtResource("4_progress")]
unique_name_in_owner = true
layout_mode = 2

[node name="Nav" type="HBoxContainer" parent="Top"]
layout_mode = 2
size_flags_vertical = 0
mouse_filter = 2

[node name="PreviousButton" type="Button" parent="Top/Nav"]
unique_name_in_owner = true
