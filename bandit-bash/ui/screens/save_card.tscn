[gd_scene format=3]

[ext_resource type="Script" path="res://ui/screens/save_card.gd" id="1_card"]

[node name="SaveCard" type="PanelContainer"]
theme_type_variation = &"RowPanel"
script = ExtResource("1_card")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Save 1"

[node name="Detail" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Empty"

[node name="Buttons" type="HBoxContainer" parent="Column"]
layout_mode = 2

[node name="OpenButton" type="Button" parent="Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Open"

[node name="DeleteButton" type="Button" parent="Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Delete"
