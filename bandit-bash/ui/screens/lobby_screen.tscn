[gd_scene format=3]

[ext_resource type="Script" path="res://ui/screens/lobby_screen.gd" id="1_lobby"]
[ext_resource type="Script" path="res://ui/common/nav_button.gd" id="2_nav"]
[ext_resource type="PackedScene" path="res://ui/battle/input/input_device_adapter.tscn" id="3_device"]
[ext_resource type="Script" path="res://ui/common/screen_hints.gd" id="4_hints"]
[ext_resource type="PackedScene" path="res://ui/battle/hud/control_hint_bar.tscn" id="5_bar"]

[sub_resource type="InputEventAction" id="InputEventAction_back"]
action = &"ui_cancel"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_back")]

[node name="LobbyScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lobby")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2

[node name="Title" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Lobby"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="VersionLabel" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
horizontal_alignment = 1

[node name="CodeRow" type="HBoxContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="CodeLabel" type="Label" parent="Center/Column/CodeRow"]
layout_mode = 2
text = "Lobby code:"

[node name="CodeField" type="LineEdit" parent="Center/Column/CodeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
editable = false

[node name="CopyButton" type="Button" parent="Center/Column/CodeRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Copy"

[node name="HostButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Host Lobby"

[node name="JoinRow" type="HBoxContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="JoinInput" type="LineEdit" parent="Center/Column/JoinRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
placeholder_text = "Lobby code"

[node name="JoinButton" type="Button" parent="Center/Column/JoinRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Join"

[node name="FriendsRow" type="HBoxContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="FriendsLabel" type="Label" parent="Center/Column/FriendsRow"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Friends' games"

[node name="RefreshFriendsButton" type="Button" parent="Center/Column/FriendsRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Refresh"

[node name="FriendsList" type="VBoxContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="MembersList" type="VBoxContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="ReadyToggle" type="CheckButton" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Ready"

[node name="InviteButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Invite Friends"

[node name="StartButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Start Match"

[node name="LeaveButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Leave Lobby"

[node name="BackButton" type="Button" parent="Center/Column" groups=["ui_sound_back"]]
unique_name_in_owner = true
layout_mode = 2
shortcut = SubResource("Shortcut_back")
shortcut_in_tooltip = false
text = "Back"
script = ExtResource("2_nav")
target_screen = 5

[node name="InputDeviceAdapter" parent="." instance=ExtResource("3_device")]

[node name="ScreenHints" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("4_hints")
context = &"MENU"
actions = Dictionary[StringName, PackedStringArray]({
&"MENU": PackedStringArray("ui_up", "ui_down", "ui_left", "ui_right", "ui_accept", "ui_cancel")
})

[node name="ControlHintBar" parent="." node_paths=PackedStringArray("controller", "device") instance=ExtResource("5_bar")]
unique_name_in_owner = true
layout_mode = 1
controller = NodePath("../ScreenHints")
device = NodePath("../InputDeviceAdapter")
right_margin = 8.0
