[gd_scene format=3]

[ext_resource type="Script" path="res://ui/screens/options_screen.gd" id="1_options"]
[ext_resource type="Script" path="res://ui/common/nav_button.gd" id="1_nav"]
[ext_resource type="PackedScene" path="res://ui/screens/setting_toggle.tscn" id="2_toggle"]
[ext_resource type="PackedScene" path="res://ui/battle/input/input_device_adapter.tscn" id="3_device"]
[ext_resource type="Script" path="res://ui/common/screen_hints.gd" id="4_hints"]
[ext_resource type="PackedScene" path="res://ui/battle/hud/control_hint_bar.tscn" id="5_bar"]

[sub_resource type="InputEventAction" id="InputEventAction_back"]
action = &"ui_cancel"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_back")]

[node name="OptionsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_options")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2

[node name="Title" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Options"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="Rows" type="VBoxContainer" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="OpeningSwapToggle" parent="Center/Column" instance=ExtResource("2_toggle")]
unique_name_in_owner = true
layout_mode = 2
label_text = "Opening swap"
hint_text = "On: each battle opens with a window to trade your units' tiles before turn 1, closed by Start. Off: turn 1 starts at once."

[node name="ApplyButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Apply"

[node name="BackButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
shortcut = SubResource("Shortcut_back")
shortcut_in_tooltip = false
text = "Back"
script = ExtResource("1_nav")
action = 1

[node name="InputDeviceAdapter" parent="." instance=ExtResource("3_device")]

[node name="ScreenHints" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("4_hints")
context = &"MENU"
actions = Dictionary[StringName, PackedStringArray]({
&"MENU": PackedStringArray("ui_up", "ui_down", "ui_left", "ui_right", "ui_accept", "ui_cancel")
})

[node name="ControlHintBar" parent="." node_paths=PackedStringArray("controller", "device") instance=ExtResource("5_bar")]
unique_name_in_owner = true
layout_mode = 1
controller = NodePath("../ScreenHints")
device = NodePath("../InputDeviceAdapter")
right_margin = 8.0
labels = Dictionary[String, String]({
"MENU/ui_left": "Volume",
"MENU/ui_right": "Volume",
"ui_accept": "Select",
"ui_cancel": "Back",
"ui_down": "Move",
"ui_left": "Move",
"ui_right": "Move",
"ui_up": "Move"
})
