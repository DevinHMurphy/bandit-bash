[gd_scene format=3]

[ext_resource type="Script" path="res://ui/common/nav_button.gd" id="1_nav"]
[ext_resource type="Script" path="res://ui/screens/main_menu.gd" id="2_main_menu"]
[ext_resource type="PackedScene" path="res://ui/battle/input/input_device_adapter.tscn" id="3_device"]
[ext_resource type="Script" path="res://ui/common/screen_hints.gd" id="4_hints"]
[ext_resource type="PackedScene" path="res://ui/battle/hud/control_hint_bar.tscn" id="5_bar"]

[sub_resource type="InputEventAction" id="InputEventAction_back"]
action = &"ui_cancel"

[sub_resource type="Shortcut" id="Shortcut_back"]
events = [SubResource("InputEventAction_back")]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_main_menu")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2

[node name="Title" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Main Menu (placeholder)"
horizontal_alignment = 1

[node name="Header" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Continue Run"

[node name="NewRunButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "New Run"

[node name="AbandonButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Abandon Run"

[node name="MultiplayerButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Multiplayer"

[node name="ResumeMultiButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Resume Campaign"

[node name="AbandonMultiButton" type="Button" parent="Center/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Abandon Multiplayer Campaign"

[node name="OptionsButton" type="Button" parent="Center/Column"]
layout_mode = 2
text = "Options"
script = ExtResource("1_nav")
target_screen = 6

[node name="BackButton" type="Button" parent="Center/Column" groups=["ui_sound_back"]]
unique_name_in_owner = true
layout_mode = 2
shortcut = SubResource("Shortcut_back")
shortcut_in_tooltip = false
text = "Back to Save Select"
script = ExtResource("1_nav")
target_screen = 7

[node name="AbandonDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Abandon Run"

[node name="InputDeviceAdapter" parent="." instance=ExtResource("3_device")]

[node name="ScreenHints" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("4_hints")
context = &"MENU"
actions = Dictionary[StringName, PackedStringArray]({
&"MENU": PackedStringArray("ui_up", "ui_down", "ui_accept", "ui_cancel")
})

[node name="ControlHintBar" parent="." node_paths=PackedStringArray("controller", "device") instance=ExtResource("5_bar")]
unique_name_in_owner = true
layout_mode = 1
controller = NodePath("../ScreenHints")
device = NodePath("../InputDeviceAdapter")
right_margin = 8.0
