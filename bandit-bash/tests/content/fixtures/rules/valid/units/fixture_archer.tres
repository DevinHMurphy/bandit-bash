[ext_resource type="Script" path="res://scripts/effects/blocks/values/constant.gd" id="3_con"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/gain_resource.gd" id="4_gain"]
[ext_resource type="Script" path="res://scripts/content/unit_type_definition.gd" id="9_def"]

[sub_resource type="Resource" id="Resource_amount"]
