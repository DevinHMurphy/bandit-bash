[gd_resource type="Resource" script_class="RuneDefinition" format=3]

[ext_resource type="Script" path="res://scripts/effects/effect_definition.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/effect_operation.gd" id="2_ops"]
[ext_resource type="Script" path="res://scripts/effects/blocks/values/constant.gd" id="3_con"]
[ext_resource type="Script" path="res://scripts/effects/blocks/operations/gain_resource.gd" id="4_gain"]
[ext_resource type="Script" path="res://scripts/content/rune_definition.gd" id="9_def"]

[sub_resource type="Resource" id="Resource_amount"]
script = ExtResource("3_con")
value = 10.0

[sub_resource type="Resource" id="Resource_op"]
script = ExtResource("4_gain")
pool = 0
amount = SubResource("Resource_amount")

[sub_resource type="Resource" id="Resource_effect"]
script = ExtResource("1_eff")
id = "fixture_mend_effect"
operations = Array[ExtResource("2_ops")]([SubResource("Resource_op")])

[resource]
script = ExtResource("9_def")
target_kind = "area"
shape_id = "fixture_adjacent"
id = "fixture_mend"
display_name = "Fixture Mend"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_effect")])
