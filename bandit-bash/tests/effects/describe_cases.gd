extends "res://tests/effects/effects_case_base.gd"
## Effect text cases for tests/effects/run_all.gd: text generated by [EffectDefinition],
## [EffectCarrierDefinition] and every block, and the key fields' dropdowns.


# The suite that runs this file; tests/case_files.gd finds it by this line.
const SUITE: String = "effects"

func run() -> void:
	_test_describe_helpers()
	_test_describe_conditions()
	_test_describe_operations()
	_test_describe_selectors()
	_test_describe_area_shapes()
	_test_describe_values()
	_test_describe_coverage_fixtures()
	_test_describe_definition_shapes()
	_test_key_fields_offer_a_dropdown()


func _test_describe_helpers() -> void:
	var ordinals: PackedStringArray = []
	for number: int in [1, 2, 3, 4, 10, 11, 12, 13, 21, 22, 101, 111, 112]:
		ordinals.append(EffectTerms.ordinal(number))
	_check(
			"describe: ordinals",
			", ".join(ordinals) == "1st, 2nd, 3rd, 4th, 10th, 11th, 12th, 13th, 21st, 22nd, 101st,"
			+ " 111th, 112th",
			", ".join(ordinals)
	)
	_snapshot("key name: combat value", EffectTerms.key_name(CombatValue.Key.ATK_X), "Atk X")
	_snapshot(
			"key name: damage stage",
			EffectTerms.key_name(DamageStage.Key.MULTIPLIERS),
			"Multipliers stage"
	)
	_snapshot(
			"key name: campaign permission",
			EffectTerms.key_name(CampaignValue.Permission.STAT_CAN_GROW),
			"Stat Can Grow"
	)
	_snapshot("key name: unknown", EffectTerms.key_name(999), "Key 999")
	_snapshot("number: whole", EffectTerms.format_number(3.0), "3")
	_snapshot("number: fraction", EffectTerms.format_number(0.5), "0.5")


func _test_describe_conditions() -> void:
	var tenth: CounterCondition = CounterCondition.new()
	tenth.count = 10
	_snapshot("counter: every Nth", tenth.describe(), "every 10th time this combat")
	_snapshot("counter: words before the trigger", tenth.describe_count(), "Every 10th")
	var first: CounterCondition = CounterCondition.new()
	first.mode = CounterCondition.Mode.FIRST
	first.lane = EffectTerms.Lane.CAMPAIGN
	_snapshot("counter: first", first.describe(), "first time this campaign")

	var chance: ChanceCondition = ChanceCondition.new()
	chance.chance_percent = 25
	_snapshot("chance", chance.describe(), "25% chance")

	var exposed: WhileStateCondition = WhileStateCondition.new()
	_snapshot("while state: this unit", exposed.describe(), "while Exposed")
	exposed.subject = WhileStateCondition.Subject.OPPONENT
	_snapshot("while state: opponent", exposed.describe(), "while the opponent is Exposed")

	var faster: WhileCompareCondition = WhileCompareCondition.new()
	faster.key = CombatValue.Key.ATTACK_SPEED
	_snapshot(
			"while compare: opponent",
			faster.describe(),
			"while this unit's Attack Speed is higher than its opponent's"
	)
	var wounded: WhileCompareCondition = WhileCompareCondition.new()
	wounded.quantity = WhileCompareCondition.Quantity.HP_PERCENT
	wounded.comparison = WhileCompareCondition.Comparison.LOWER_THAN
	wounded.against = WhileCompareCondition.Against.THRESHOLD
	wounded.threshold = 50.0
	_snapshot(
			"while compare: threshold",
			wounded.describe(),
			"while this unit's HP % is lower than 50"
	)

	var expected_positions: Dictionary[int, String] = {
		WhilePositionCondition.Kind.AT_MAXIMUM_RANGE: "while at maximum range",
		WhilePositionCondition.Kind.MOVED_AT_LEAST: "while this unit moved 4+ tiles this turn",
		WhilePositionCondition.Kind.HAS_NOT_MOVED: "while it hasn't moved this turn",
		WhilePositionCondition.Kind.NO_ALLY_CLOSER_TO_ENEMY:
				"while no ally is closer to an enemy than this unit",
		WhilePositionCondition.Kind.ADJACENT_TO: "while adjacent to an enemy",
		WhilePositionCondition.Kind.WITHIN: "while within 4 tiles of an enemy",
	}
	for kind: int in expected_positions:
		var position: WhilePositionCondition = WhilePositionCondition.new()
		position.kind = kind as WhilePositionCondition.Kind
		position.tiles = 4
		position.side = EffectTerms.UnitSide.ENEMY
		var kind_name: String = WhilePositionCondition.Kind.find_key(kind)
		_snapshot("while position: %s" % [kind_name], position.describe(), expected_positions[kind])

	var defender: WhileRoleCondition = WhileRoleCondition.new()
	defender.role = WhileRoleCondition.Role.DEFENDER
	_snapshot("while role", defender.describe(), "while it is the defender")

	var gloom: WhileLayerCondition = WhileLayerCondition.new()
	gloom.layer = WhileLayerCondition.Layer.GLOOM
	gloom.or_deeper = true
	_snapshot("while layer: or deeper", gloom.describe(), "while on Gloom or deeper")
	var abyss: WhileLayerCondition = WhileLayerCondition.new()
	abyss.layer = WhileLayerCondition.Layer.ABYSS
	_snapshot("while layer: exact", abyss.describe(), "while on Abyss")


func _test_describe_operations() -> void:
	_snapshot(
			"modify value: add",
			_modify_value(CampaignValue.Key.COMBAT_GOLD, ADD, 8.0).describe(),
			"+8 Combat Gold"
	)
	_snapshot(
			"modify value: replace base",
			_modify_value(CombatValue.Key.RANGE_MAX, REPLACE_BASE, 2.0).describe(),
			"Range Max becomes 2"
	)
	var magic: float = CombatFact.DamageType.MAGIC
	_snapshot(
			"modify value: enum key shows the enum name",
			_modify_value(CombatValue.Key.DAMAGE_TYPE, FIXED, magic).describe(),
			"Damage Type always Magic"
	)
	_snapshot(
			"modify value: multiply",
			_modify_value(CampaignValue.Key.HEALING_RECEIVED_PERCENT, MULTIPLY, 0.5).describe(),
			"×0.5 Healing Received Percent"
	)
	_snapshot(
			"modify value: floor",
			_modify_value(CampaignValue.Key.LEVEL_UP_MIN_STATS, FLOOR, 3.0).describe(),
			"Level Up Min Stats at least 3"
	)
	_snapshot(
			"modify value: negative add",
			_modify_value(CombatValue.Key.MOVEMENT, ADD, -1.0).describe(),
			"-1 Movement"
	)

	var halve: ModifyThat = ModifyThat.new()
	halve.key = DamageStage.Key.MULTIPLIERS
	halve.mode = MULTIPLY
	halve.value = 0.5
	_snapshot(
			"modify that: value, named by trigger",
			halve.describe_for_trigger(EffectTerms.Trigger.HIT_TAKEN),
			"×0.5 damage for that hit"
	)
	_check("modify that: inline", halve.is_inline())
	var lifesteal: ModifyThat = ModifyThat.new()
	lifesteal.what = ModifyThat.What.FLAG
	_snapshot(
			"modify that: lifesteal",
			lifesteal.describe_for_trigger(EffectTerms.Trigger.ATTACK_MADE),
			"that attack gains lifesteal"
	)
	lifesteal.flag = ModifyThat.Flag.SKIP_MITIGATION
	_snapshot(
			"modify that: skip Mitigation",
			lifesteal.describe_for_trigger(EffectTerms.Trigger.CRIT_DEALT),
			"that hit skips Mitigation"
	)
	var brittle: ModifyThat = ModifyThat.new()
	brittle.what = ModifyThat.What.AMOUNT
	brittle.value = -1.0
	_snapshot(
			"modify that: amount",
			brittle.describe_for_trigger(EffectTerms.Trigger.BLOCK_GAINED),
			"-1 to that Block gain"
	)
	_snapshot("modify that: no trigger", brittle.describe(), "-1 to that action")

	var momentum: AddTimedModifier = _timed(CombatValue.Key.HIT, ADD, 15.0)
	momentum.end = AddTimedModifier.End.THIS_COMBAT
	momentum.uses = 1
	_snapshot(
			"timed: next attack",
			momentum.describe(),
			"gain +15 Hit on its next attack this combat"
	)
	var horn: AddTimedModifier = _timed(DamageStage.Key.ATTACK, ADD, 2.0)
	horn.target = _area(Area.Center.OWNER, 2, EffectTerms.UnitSide.ANY, false)
	horn.end = AddTimedModifier.End.END_OF_NEXT_PHASE
	_snapshot(
			"timed: area until the end of the next phase",
			horn.describe(),
			"give units within 2 tiles, friend or foe +2 Attack until the end of the next"
			+ " phase"
	)
	var may_move: int = CombatValue.Permission.MAY_MOVE_AFTER_ACTING
	var skirmish: AddTimedModifier = _timed(may_move, GRANT, 0.0)
	skirmish.end = AddTimedModifier.End.UNTIL_PHASE_END
	_snapshot(
			"timed: permission",
			skirmish.describe(),
			"may move after acting until Phase End"
	)
	skirmish.target = FactActor.new()
	skirmish.uses = 2
	_snapshot(
			"timed: permission for a target, with uses",
			skirmish.describe(),
			"that unit may move after acting on its next 2 attacks until Phase End"
	)

	var block: GainResource.Pool = GainResource.Pool.BLOCK
	_snapshot("gain: Block", _gain(block, null, _constant(3.0)).describe(), "gain 3 Block")
	var hp: GainResource.Pool = GainResource.Pool.HP
	_snapshot("gain: heal", _gain(hp, null, _constant(10.0)).describe(), "heal 10")
	_snapshot(
			"gain: heal a target",
			_gain(GainResource.Pool.HP, FactActor.new(), _constant(10.0)).describe(),
			"heal that unit for 10"
	)
	var stance: GainResource = _gain(GainResource.Pool.STANCE, Owner.new(), _constant(1.0))
	_snapshot("gain: Stance", stance.describe(), "gain 1 Stance")
	var adjacent_allies: Area = _area(Area.Center.OWNER, 1, EffectTerms.UnitSide.ALLY, false)
	_snapshot(
			"gain: equal to a count",
			_gain(GainResource.Pool.BLOCK, null, _count(adjacent_allies)).describe(),
			"gain Block equal to the number of adjacent allies"
	)
	_snapshot(
			"gain: a target, equal to a share of the fact",
			_gain(GainResource.Pool.BLOCK, FactActor.new(), _percent_of_overheal()).describe(),
			"give that unit Block equal to 100% of that overheal"
	)
	_snapshot(
			"gain: negative is a loss",
			_gain(GainResource.Pool.BLOCK, _random_of_army(), _constant(-2.0)).describe(),
			"remove 2 Block from a random one of your units"
	)
	_snapshot(
			"gain: own loss",
			_gain(GainResource.Pool.BLOCK, null, _constant(-1.0)).describe(),
			"lose 1 Block"
	)
	_snapshot(
			"gain: HP equal to a share",
			_gain(GainResource.Pool.HP, null, _percent_of_overheal()).describe(),
			"heal for 100% of that overheal"
	)

	var cleave: DealSplash = DealSplash.new()
	cleave.target = _area(Area.Center.OWNER, 1, EffectTerms.UnitSide.ANY, false)
	cleave.amount = _constant(2.0)
	_snapshot("splash", cleave.describe(), "deal 2 splash damage to adjacent units, friend or foe")
	cleave.amount = _count(adjacent_allies)
	_snapshot(
			"splash: computed amount",
			cleave.describe(),
			"deal splash damage equal to the number of adjacent allies to adjacent units, friend"
			+ " or foe"
	)

	var booster: ChangeBaseStat = ChangeBaseStat.new()
	booster.key = CombatValue.Key.MOVEMENT
	booster.value = 1.0
	_snapshot("change base stat", booster.describe(), "permanently +1 Movement")
	booster.target = FactTarget.new()
	_snapshot(
			"change base stat: target",
			booster.describe(),
			"permanently give the other unit +1 Movement"
	)
	var ingredient: ChangeBaseStat = ChangeBaseStat.new()
	ingredient.key = CombatValue.Key.RES
	ingredient.mode = ChangeBaseStat.Mode.GROWTH
	ingredient.value = 5.0
	_snapshot("change base stat: growth", ingredient.describe(), "permanently +5% RES growth")

	var permission_op: SetPermission = SetPermission.new()
	permission_op.permission = CombatValue.Permission.CAN_BE_SHOVED
	_snapshot("set permission: allow", permission_op.describe(), "can be shoved")
	permission_op.permission = CampaignValue.Permission.STAT_CAN_GROW
	permission_op.allow = false
	_snapshot("set permission: deny", permission_op.describe(), "stats can't grow")

	var grant: CampaignGrant = CampaignGrant.new()
	grant.amount = 50
	_snapshot("campaign grant: gold", grant.describe(), "gain 50 gold")
	grant.grant = CampaignGrant.Grant.HEIRLOOM
	_snapshot("campaign grant: unnamed heirloom", grant.describe(), "gain an heirloom")
	grant.grant = CampaignGrant.Grant.RUNE
	grant.definition_id = "mend"
	_snapshot("campaign grant: named rune", grant.describe(), "gain the rune mend")
	grant.grant = CampaignGrant.Grant.RECRUIT
	grant.definition_id = ""
	_snapshot("campaign grant: recruit", grant.describe(), "recruit a unit")

	var custom: CustomOperation = CustomOperation.new()
	custom.text = "swap places with an adjacent ally"
	custom.inline = true
	_snapshot("custom: authored text", custom.describe(), "swap places with an adjacent ally")
	_check(
			"inline flags: custom as set, queued operations not inline",
			custom.is_inline() and not cleave.is_inline() and not momentum.is_inline()
	)


func _test_describe_selectors() -> void:
	_snapshot("owner", Owner.new().describe(), "this unit")
	_check("owner: is the owner", Owner.new().is_owner() and not FactActor.new().is_owner())
	_snapshot("fact actor", FactActor.new().describe(), "that unit")
	_snapshot("fact target", FactTarget.new().describe(), "the other unit")
	_snapshot(
			"area: adjacent, friend or foe",
			_area(Area.Center.OWNER, 1, EffectTerms.UnitSide.ANY, false).describe(),
			"adjacent units, friend or foe"
	)
	_snapshot(
			"area: with the center",
			_area(Area.Center.OWNER, 2, EffectTerms.UnitSide.ALLY, true).describe(),
			"this unit and allies within 2 tiles"
	)
	_snapshot(
			"area: around the fact's actor",
			_area(Area.Center.FACT_ACTOR, 1, EffectTerms.UnitSide.ENEMY, false).describe(),
			"adjacent enemies of that unit"
	)
	_snapshot(
			"area: around the command target",
			_area(Area.Center.COMMAND_TARGET, 1, EffectTerms.UnitSide.ALLY, true).describe(),
			"the target and adjacent allies of the target"
	)
	var against: WhileAttackCondition = WhileAttackCondition.new()
	# NOTE: "beast" is not in ContentIds.TAGS on purpose: only the text is tested here.
	against.type_name = "beast"
	_snapshot("while attack: against a tag", against.describe(), "against Beasts")
	against.type_name = ContentIds.TAG_ARMORED
	_snapshot("while attack: an adjective tag", against.describe(), "against Armored units")
	var from_magic: WhileAttackCondition = WhileAttackCondition.new()
	from_magic.role = WhileAttackCondition.Role.ATTACKED
	from_magic.kind = WhileAttackCondition.Kind.DAMAGE_TYPE
	_snapshot("while attack: from magic", from_magic.describe(), "from magic")
	from_magic.kind = WhileAttackCondition.Kind.WEAPON_TYPE
	from_magic.type_name = "bow"
	_snapshot("while attack: from a weapon type", from_magic.describe(), "from bows")
	from_magic.kind = WhileAttackCondition.Kind.IS_CRIT
	_snapshot("while attack: from a crit", from_magic.describe(), "from a crit")
	var everyone: AllOfScope = AllOfScope.new()
	_snapshot("all of scope: default", everyone.describe(), "your units")
	everyone.scope = EffectTerms.Scope.ANY_UNIT
	_snapshot("all of scope: any unit", everyone.describe(), "every unit")
	_snapshot("random of", _random_of_army().describe(), "a random one of your units")


# The text of each shape kind an Area can read; radius keeps the wording above.
func _test_describe_area_shapes() -> void:
	var square: Area = _area(Area.Center.OWNER, 1, EffectTerms.UnitSide.ALLY, false)
	square.shape.kind = ContentIds.SHAPE_SQUARE
	_snapshot("area: square 1", square.describe(), "adjacent allies, diagonals included")
	square.shape.size = 2
	_snapshot("area: square 2", square.describe(), "allies within 2 tiles, diagonals included")
	var cross: Area = _area(Area.Center.FACT_ACTOR, 3, EffectTerms.UnitSide.ENEMY, true)
	cross.shape.kind = ContentIds.SHAPE_CROSS
	_snapshot(
			"area: cross 3 with the center",
			cross.describe(),
			"that unit and enemies within 3 tiles in a straight line of that unit"
	)
	var tile: Area = _area(Area.Center.COMMAND_TARGET, 2, EffectTerms.UnitSide.ALLY, true)
	tile.shape.kind = ContentIds.SHAPE_TILE
	_snapshot("area: the center tile only", tile.describe(), "the target")
	tile.shape.includes_center = false
	_snapshot("area: a tile without its center", tile.describe(), "no units")
	var radius_zero: Area = _area(Area.Center.OWNER, 0, EffectTerms.UnitSide.ANY, true)
	_snapshot("area: radius 0 is the center", radius_zero.describe(), "this unit")
	var unshaped: Area = Area.new()
	_snapshot("area: no shape", unshaped.describe(), "no units")


func _test_describe_values() -> void:
	_snapshot("constant", _constant(3.0).describe(), "3")
	_snapshot("constant: fraction", _constant(2.5).describe(), "2.5")
	var overheal: PercentOfFact = _percent_of_overheal()
	_snapshot("percent of fact: overheal", overheal.describe(), "100% of that overheal")
	var half: PercentOfFact = PercentOfFact.new()
	half.percent = 50.0
	_snapshot("percent of fact: amount", half.describe(), "50% of that amount")
	var movement: StatOf = StatOf.new()
	movement.key = CombatValue.Key.MOVEMENT
	_snapshot("stat of: owner", movement.describe(), "this unit's Movement")
	movement.subject = FactTarget.new()
	_snapshot("stat of: subject", movement.describe(), "the other unit's Movement")
	var stance: ResourceOf = ResourceOf.new()
	_snapshot("resource of: owner", stance.describe(), "this unit's current Stance")
	stance.pool = GainResource.Pool.BLOCK
	stance.subject = FactTarget.new()
	_snapshot("resource of: subject", stance.describe(), "the other unit's current Block")
	var adjacent_allies: Area = _area(Area.Center.OWNER, 1, EffectTerms.UnitSide.ALLY, false)
	var doubled: CountOf = _count(adjacent_allies)
	_snapshot("count of", doubled.describe(), "the number of adjacent allies")
	doubled.each = 2.0
	_snapshot("count of: each", doubled.describe(), "2 × the number of adjacent allies")
	var counter: CounterValue = CounterValue.new()
	counter.lane = EffectTerms.Lane.CAMPAIGN
	_snapshot("counter value", counter.describe(), "its count this campaign")


# The coverage fixtures of the event bus plan (Effect data model), as authored effect text.
func _test_describe_coverage_fixtures() -> void:
	var no_ally_closer: WhilePositionCondition = WhilePositionCondition.new()
	no_ally_closer.kind = WhilePositionCondition.Kind.NO_ALLY_CLOSER_TO_ENEMY
	var vanguard: EffectDefinition = _definition(
			EffectTerms.Trigger.PHASE_START,
			[no_ally_closer],
			[_gain(GainResource.Pool.BLOCK, null, _constant(3.0))]
	)
	_snapshot(
			"fixture: Vanguard",
			vanguard.describe(),
			"Phase Start, while no ally is closer to an enemy than this unit: gain 3 Block"
	)

	var seventh: CounterCondition = CounterCondition.new()
	seventh.count = 7
	var lifesteal: ModifyThat = ModifyThat.new()
	lifesteal.what = ModifyThat.What.FLAG
	var iron_heart: EffectDefinition = _definition(
			EffectTerms.Trigger.ATTACK_MADE, [seventh], [lifesteal]
	)
	iron_heart.scope = EffectTerms.Scope.YOUR_UNIT
	_snapshot(
			"fixture: Iron Heart",
			iron_heart.describe(),
			"Every 7th Attack made by Your Unit this combat: that attack gains lifesteal"
	)

	var plus_hit: AddTimedModifier = _timed(CombatValue.Key.HIT, ADD, 15.0)
	plus_hit.end = AddTimedModifier.End.THIS_COMBAT
	plus_hit.uses = 1
	_snapshot(
			"fixture: Momentum",
			_definition(EffectTerms.Trigger.MISSED, [], [plus_hit]).describe(),
			"Missed: gain +15 Hit on its next attack this combat"
	)

	var adjacent_allies: Area = _area(Area.Center.OWNER, 1, EffectTerms.UnitSide.ALLY, false)
	var phalanx_gain: GainResource = _gain(GainResource.Pool.BLOCK, null, _count(adjacent_allies))
	_snapshot(
			"fixture: Phalanx",
			_definition(EffectTerms.Trigger.UNIT_TURN_START, [], [phalanx_gain]).describe(),
			"Unit Turn Start: gain Block equal to the number of adjacent allies"
	)

	var splash: DealSplash = DealSplash.new()
	splash.target = _area(Area.Center.OWNER, 1, EffectTerms.UnitSide.ANY, false)
	splash.amount = _constant(2.0)
	_snapshot(
			"fixture: Cleave",
			_definition(EffectTerms.Trigger.HIT_DEALT, [], [splash]).describe(),
			"Hit dealt: deal 2 splash damage to adjacent units, friend or foe"
	)

	var second: CounterCondition = CounterCondition.new()
	second.count = 2
	var horn: AddTimedModifier = _timed(DamageStage.Key.ATTACK, ADD, 2.0)
	horn.target = _area(Area.Center.OWNER, 2, EffectTerms.UnitSide.ANY, true)
	horn.end = AddTimedModifier.End.END_OF_NEXT_PHASE
	_snapshot(
			"fixture: War Horn",
			_definition(EffectTerms.Trigger.PHASE_START, [second], [horn]).describe(),
			"Every 2nd Phase Start this combat: give this unit and units within 2 tiles, friend or"
			+ " foe +2 Attack until the end of the next phase"
	)

	var cup_gain: GainResource = _gain(
			GainResource.Pool.BLOCK, FactActor.new(), _percent_of_overheal()
	)
	var cup: EffectDefinition = _definition(EffectTerms.Trigger.HEALED, [], [cup_gain])
	cup.scope = EffectTerms.Scope.YOUR_UNIT
	_snapshot(
			"fixture: Overflowing Cup",
			cup.describe(),
			"When Your Unit is healed: give that unit Block equal to 100% of that overheal"
	)

	var halve: ModifyThat = ModifyThat.new()
	halve.key = DamageStage.Key.MULTIPLIERS
	halve.mode = MULTIPLY
	halve.value = 0.5
	var lantern: EffectDefinition = _definition(
			EffectTerms.Trigger.DARKNESS_DAMAGE_TAKEN, [], [halve]
	)
	lantern.scope = EffectTerms.Scope.YOUR_UNIT
	_snapshot(
			"fixture: Lantern Oil",
			lantern.describe(),
			"When Your Unit takes darkness damage: ×0.5 damage for that darkness damage"
	)

	var gold: ModifyValue = _modify_value(CampaignValue.Key.COMBAT_GOLD, ADD, 8.0)
	_snapshot(
			"fixture: Bounty Ledger",
			_definition(EffectTerms.Trigger.ALWAYS, [], [gold]).describe(),
			"Always: +8 Combat Gold"
	)

	var no_growth: SetPermission = SetPermission.new()
	no_growth.permission = CampaignValue.Permission.STAT_CAN_GROW
	no_growth.allow = false
	var gain_might: ModifyValue = _modify_value(
			CampaignValue.Key.LEVEL_UP_GUARANTEED_GAINS, ADD, 1.0
	)
	_snapshot(
			"fixture: Training Weights without stats named (engine cases name them)",
			_definition(EffectTerms.Trigger.ALWAYS, [], [no_growth, gain_might]).describe(),
			"Always: stats can't grow, +1 Level Up Guaranteed Gains"
	)

	var minus_one: ModifyThat = ModifyThat.new()
	minus_one.what = ModifyThat.What.AMOUNT
	minus_one.value = -1.0
	var brittle: EffectDefinition = _definition(
			EffectTerms.Trigger.BLOCK_GAINED, [], [minus_one]
	)
	brittle.scope = EffectTerms.Scope.YOUR_UNIT
	brittle.tags = EffectDefinition.Tag.CURSE
	_snapshot(
			"fixture: Brittle Guard",
			brittle.describe(),
			"When Your Unit gains Block: -1 to that Block gain"
	)
	_check(
			"fixture: Brittle Guard is a curse, not unique",
			brittle.has_tag(EffectDefinition.Tag.CURSE)
			and not brittle.has_tag(EffectDefinition.Tag.UNIQUE)
	)

	var haunt: AddTimedModifier = _timed(
			CombatValue.Permission.CAN_GAIN_BLOCK, Modifier.Mode.DENY, 0.0
	)
	haunt.target = _random_of_army()
	haunt.end = AddTimedModifier.End.END_OF_NEXT_PHASE
	var haunted: EffectDefinition = _definition(EffectTerms.Trigger.PHASE_START, [], [haunt])
	haunted.scope = EffectTerms.Scope.YOUR_UNIT
	_snapshot(
			"fixture: Haunted",
			haunted.describe(),
			"Phase Start: a random one of your units can't gain Block until"
			+ " the end of the next phase"
	)


func _test_describe_definition_shapes() -> void:
	var tenth: CounterCondition = CounterCondition.new()
	tenth.count = 10
	var chance: ChanceCondition = ChanceCondition.new()
	chance.chance_percent = 25
	var halve: ModifyThat = ModifyThat.new()
	halve.key = DamageStage.Key.MULTIPLIERS
	halve.mode = MULTIPLY
	halve.value = 0.5
	_snapshot(
			"definition: counter, then other conditions",
			_definition(EffectTerms.Trigger.HIT_TAKEN, [chance, tenth], [halve]).describe(),
			"Every 10th Hit taken this combat, 25% chance: ×0.5 damage for that hit"
	)

	var exposed: WhileStateCondition = WhileStateCondition.new()
	var atk_x: ModifyValue = _modify_value(CombatValue.Key.ATK_X, ADD, 1.0)
	_snapshot(
			"definition: always-on with a While condition",
			_definition(EffectTerms.Trigger.ALWAYS, [exposed], [atk_x]).describe(),
			"While Exposed: +1 Atk X"
	)

	var heal: GainResource = _gain(GainResource.Pool.HP, null, _constant(10.0))
	var potion: EffectDefinition = _definition(EffectTerms.Trigger.ALWAYS, [], [heal])
	potion.charges = 3
	_snapshot("definition: charges", potion.describe(), "Always: heal 10 (3 uses this combat)")
	potion.charges = 1
	potion.charge_lane = EffectTerms.Lane.CAMPAIGN
	_snapshot("definition: one charge", potion.describe(), "Always: heal 10 (1 use this campaign)")

	var carrier: EffectCarrierDefinition = EffectCarrierDefinition.new()
	carrier.id = "bounty_ledger"
	carrier.display_name = "Bounty Ledger"
	var gold: ModifyValue = _modify_value(CampaignValue.Key.COMBAT_GOLD, ADD, 8.0)
	carrier.effects = [
		_definition(EffectTerms.Trigger.ALWAYS, [], [gold]),
		null,
		potion,
	]
	_check(
			"carrier: one line per effect, nulls skipped",
			carrier.describe() == PackedStringArray([
				"Always: +8 Combat Gold",
				"Always: heal 10 (1 use this campaign)",
			]),
			str(carrier.describe())
	)


# Key fields get a generated enum dropdown, so designers pick keys by name.
func _test_key_fields_offer_a_dropdown() -> void:
	var value_hint: Dictionary = _property(ModifyValue.new(), "key")
	_check(
			"dropdown: value keys by name",
			(value_hint.get("hint", -1) == PROPERTY_HINT_ENUM) as bool
			and (value_hint.get("hint_string", "") as String).contains("Combat Gold:2000")
			and (value_hint.get("hint_string", "") as String).contains("Multipliers stage:1003"),
			str(value_hint.get("hint_string", ""))
	)
	var permission_hint: Dictionary = _property(SetPermission.new(), "permission")
	_check(
			"dropdown: permission keys by name",
			(permission_hint.get("hint", -1) == PROPERTY_HINT_ENUM) as bool
			and (permission_hint.get("hint_string", "") as String).contains("Can Counter:3000")
	)
	var timed_hint: Dictionary = _property(AddTimedModifier.new(), "key")
	_check(
			"dropdown: timed modifiers offer values and permissions",
			(timed_hint.get("hint_string", "") as String).contains("Hit:4")
			and (timed_hint.get("hint_string", "") as String).contains("Can Be Shoved:3001")
	)


func _property(object: Object, property_name: String) -> Dictionary:
	for property: Dictionary in object.get_property_list():
		if property["name"] == property_name:
			return property
	return {}


func _definition(
		trigger: EffectTerms.Trigger, conditions: Array, operations: Array
) -> EffectDefinition:
	var definition: EffectDefinition = EffectDefinition.new()
	definition.trigger = trigger
	definition.conditions.assign(conditions)
	definition.operations.assign(operations)
	return definition


func _modify_value(key: int, mode: Modifier.Mode, value: float) -> ModifyValue:
	var operation: ModifyValue = ModifyValue.new()
	operation.key = key
	operation.mode = mode
	operation.value = value
	return operation


func _timed(key: int, mode: Modifier.Mode, value: float) -> AddTimedModifier:
	var operation: AddTimedModifier = AddTimedModifier.new()
	operation.key = key
	operation.mode = mode
	operation.value = value
	return operation


func _gain(pool: GainResource.Pool, target: TargetSelector, amount: ValueSource) -> GainResource:
	var operation: GainResource = GainResource.new()
	operation.pool = pool
	operation.target = target
	operation.amount = amount
	return operation


func _area(
		center: Area.Center, radius: int, side: EffectTerms.UnitSide, with_center: bool
) -> Area:
	var area: Area = Area.new()
	area.center = center
	area.shape = TargetShape.new()
	area.shape.kind = ContentIds.SHAPE_RADIUS
	area.shape.size = radius
	area.shape.includes_center = with_center
	area.side = side
	return area


func _random_of_army() -> RandomOf:
	var random: RandomOf = RandomOf.new()
	random.from = AllOfScope.new()
	return random


func _constant(value: float) -> Constant:
	var constant: Constant = Constant.new()
	constant.value = value
	return constant


func _count(selector: TargetSelector) -> CountOf:
	var count: CountOf = CountOf.new()
	count.selector = selector
	return count


func _percent_of_overheal() -> PercentOfFact:
	var share: PercentOfFact = PercentOfFact.new()
	share.field = PercentOfFact.Field.OVERHEAL
	return share
