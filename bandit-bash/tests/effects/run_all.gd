func _property(object: Object, property_name: String) -> Dictionary:
	for property: Dictionary in object.get_property_list():
		if property["name"] == property_name:
			return property
	return {}


func _snapshot(case_name: String, actual: String, expected: String) -> void:
	_check("describe %s" % [case_name], actual == expected, actual)


func _definition(
		trigger: EffectTerms.Trigger, conditions: Array, operations: Array
) -> EffectDefinition:
	var definition: EffectDefinition = EffectDefinition.new()
	definition.trigger = trigger
	definition.conditions.assign(conditions)
	definition.operations.assign(operations)
	return definition


func _modify_value(key: int, mode: Modifier.Mode, value: float) -> ModifyValue:
	var operation: ModifyValue = ModifyValue.new()
	operation.key = key
	operation.mode = mode
	operation.value = value
	return operation


func _timed(key: int, mode: Modifier.Mode, value: float) -> AddTimedModifier:
	var operation: AddTimedModifier = AddTimedModifier.new()
	operation.key = key
	operation.mode = mode
	operation.value = value
	return operation


func _gain(pool: GainResource.Pool, target: TargetSelector, amount: ValueSource) -> GainResource:
	var operation: GainResource = GainResource.new()
	operation.pool = pool
	operation.target = target
	operation.amount = amount
	return operation


func _area(
		center: Area.Center, radius: int, side: EffectTerms.UnitSide, with_center: bool
) -> Area:
	var area: Area = Area.new()
	area.center = center
	area.radius = radius
	area.side = side
	area.include_center = with_center
	return area


func _random_of_army() -> RandomOf:
	var random: RandomOf = RandomOf.new()
	random.from = AllOfScope.new()
	return random


func _constant(value: float) -> Constant:
	var constant: Constant = Constant.new()
	constant.value = value
	return constant


func _count(selector: TargetSelector) -> CountOf:
	var count: CountOf = CountOf.new()
	count.selector = selector
	return count


func _percent_of_overheal() -> PercentOfFact:
	var share: PercentOfFact = PercentOfFact.new()
	share.field = PercentOfFact.Field.OVERHEAL
	return share


func _has_keys(keys: Dictionary, names: PackedStringArray) -> bool:
	for key_name: String in names:
		if not keys.has(key_name):
			return false
	return keys.size() == names.size()


func _mod(
		key: int,
		mode: Modifier.Mode,
		value: float,
		kind: Modifier.SourceKind,
		source_id: String,
		label: String
) -> Modifier:
	return Modifier.new(key, mode, value, kind, source_id, label)


# Connects a counter to every signal declared by each channel's script. Keys are "channel.signal".
func _count_channel_signals(
		channels: Dictionary[String, BusChannel], counts: Dictionary[String, int]
) -> void:
	for channel_name: String in channels:
		var channel: BusChannel = channels[channel_name]
		var script: Script = channel.get_script()
		for info: Dictionary in script.get_script_signal_list():
			var signal_name: String = info["name"]
			var key: String = "%s.%s" % [channel_name, signal_name]
			channel.connect(
					signal_name,
					func(_fact: RefCounted) -> void: counts[key] = counts.get(key, 0) + 1
			)


func _sum(counts: Dictionary[String, int]) -> int:
	var total: int = 0
	for key: String in counts:
		total += counts[key]
	return total


func _full_combat_fact() -> CombatFact:
	var fact: CombatFact = CombatFact.new(CombatFact.Kind.DAMAGE_TAKEN, "unit:57", "enemy:61")
	fact.seq = 40
	fact.session_id = 1
	fact.amount = 5
	fact.hp_amount = 3
	fact.block_amount = 2
	fact.damage_type = CombatFact.DamageType.SPLIT
	fact.source = CombatFact.Source.SPLASH
	fact.source_effect_id = "effect:9"
	fact.tile = Vector2i(4, 7)
	fact.flags = 3
	return fact


func _seq_fact(kind: CombatFact.Kind, session_id: int, seq: int) -> CombatFact:
	var fact: CombatFact = CombatFact.new(kind)
	fact.session_id = session_id
	fact.seq = seq
	return fact


# A copy of data with one slot replaced.
func _with(data: Array, index: int, value: Variant) -> Array:
	var copy: Array = data.duplicate()
	copy[index] = value
	return copy


# Stands in for a session's describe: "unit:57" -> "unit:57 (Hakkapel)".
func _describe(id: String) -> String:
	return "%s (%s)" % [id, NAMES[id]] if NAMES.has(id) else id


func _check(case_name: String, passed: bool, detail: String = "") -> void:
	if passed:
		_passes += 1
		print("PASS  %s" % [case_name])
		return
	_failures += 1
	print("FAIL  %s%s" % [case_name, "" if detail.is_empty() else "  (%s)" % [detail]])
