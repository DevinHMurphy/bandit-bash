[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/battle/unit_panel.gd" id="1_panel"]
[ext_resource type="Theme" path="res://scenes/ui/battle/battle_theme.tres" id="2_theme"]

[node name="UnitPanel" type="PanelContainer"]
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_panel")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="UnitName" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudHeading"
text = "Unit"

[node name="Status" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudNote"
text = "Has acted"

[node name="HpBar" type="ProgressBar" parent="Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
mouse_filter = 2
step = 1.0
show_percentage = false

[node name="Hp" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudText"
text = "HP 0 / 0"

[node name="Guard" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudText"
text = "Block 0 · Stance 0 / 0"

[node name="Stats" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudText"
text = "MGT 0  SPD 0  DEF 0
RES 0  CON 0  MOV 0"

[node name="Weapon" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudNote"
text = "No weapon"
autowrap_mode = 3

[node name="Gear" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudNote"
autowrap_mode = 3
